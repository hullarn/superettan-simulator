# GOAL API. Nyckeln används endast på servern.
GOAL_API_KEY=
GOAL_API_LEAGUE_ID=cmr77dvit0057rx06s7xypict
GOAL_API_SEASON=2026

# Privat admininloggning och skydd för det dagliga cron-anropet.
ADMIN_PASSWORD=
CRON_SECRET=

# Cookiefri förstapartsstatistik. Använd en unik slumpsträng med minst 32 tecken.
# I Oderland-production ska filen ligga utanför Git-repot, exempelvis
# /home/CPANEL_USER/slutspurten-data/analytics.json.
ANALYTICS_SECRET=
# ANALYTICS_FILE_PATH=.data/analytics.json

# Vercel/Upstash. Vercel-integrationen fyller normalt i dessa automatiskt.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Lokalt och på en vanlig Node-server kan lagringen i stället vara filbaserad.
# I Oderland-production ska DATA_FILE_PATH vara en absolut sökväg utanför Git-repot,
# exempelvis /home/CPANEL_USER/slutspurten-data/superettan-state.json.
# DATA_STORE=file
# DATA_FILE_PATH=.data/superettan-state.json
